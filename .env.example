# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=aether_db
POSTGRES_USER=aether
POSTGRES_PASSWORD=change_me

# ── Spring Boot datasource ───────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/aether_db
SPRING_DATASOURCE_USERNAME=aether
SPRING_DATASOURCE_PASSWORD=change_me

# ── JWT ───────────────────────────────────────────────────────────────────────
APP_JWT_SECRET=your_base64_jwt_secret_here

# ── Odoo Database ─────────────────────────────────────────────────────────────
ODOO_DB_NAME=odoo
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo_change_me
